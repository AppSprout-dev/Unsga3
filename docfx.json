{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "src/Unsga3/Unsga3.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "toc.yml",
          "docs/docfx/index.md",
          "docs/docfx/toc.yml"
        ]
      },
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Unsga3",
      "_appTitle": "Unsga3",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
